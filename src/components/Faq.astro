---
import type { Faq } from '@/lib/site';

interface Props {
  faqs: readonly Faq[];
  heading?: string;
  id?: string;
}

const { faqs, heading = 'Frequently asked questions', id = 'faq' } = Astro.props;
---

<section class="faq" aria-labelledby={`${id}-heading`}>
  <h2 id={`${id}-heading`}>{heading}</h2>
  {
    faqs.map((f, i) => (
      <details open={i === 0}>
        <summary>{f.q}</summary>
        <div class="faq__body"><p set:html={f.a} /></div>
      </details>
    ))
  }
</section>
