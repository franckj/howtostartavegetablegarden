---
import { zones, MONTHS } from '@/lib/calendar';
---

<div class="cal" id="calendar-tool">
  <div class="cal__controls">
    <div class="cal__field">
      <label for="cal-zone">Your USDA zone</label>
      <select id="cal-zone">
        {
          zones.map((z) => (
            <option value={z.zone} selected={z.zone === 6}>
              Zone {z.zone}
            </option>
          ))
        }
      </select>
    </div>
    <div class="cal__field">
      <label for="cal-month">Month</label>
      <select id="cal-month">
        {MONTHS.map((m, i) => <option value={i}>{m}</option>)}
      </select>
    </div>
  </div>

  <details class="cal__override" id="cal-override">
    <summary>Know your own frost dates? Use them instead &mdash; they beat any zone</summary>
    <div class="cal__override-body">
      <p>
        A hardiness zone describes winter lows, not frost dates, so the dates above are a
        rough default. If you have your local averages from
        <a
          href="https://www.climate.gov/news-features/understanding-climate/interactive-map-average-date-last-spring-freeze-across-united"
          rel="noopener"
          target="_blank">NOAA</a
        > or your county extension office, enter them and the whole calendar recalculates.
      </p>
      <div class="cal__controls" style="border-bottom:0;padding-bottom:0">
        <div class="cal__field">
          <label for="cal-lf">Average last spring frost</label>
          <input type="date" id="cal-lf" />
        </div>
        <div class="cal__field">
          <label for="cal-ff">Average first fall frost</label>
          <input type="date" id="cal-ff" />
        </div>
        <div class="cal__field" style="flex:0 0 auto;min-width:0">
          <button type="button" id="cal-reset" class="cal__reset">Reset to zone</button>
        </div>
      </div>
      <p class="cal__hint">The year is ignored — only the month and day are used.</p>
    </div>
  </details>

  <p class="cal__meta" id="cal-meta"></p>

  <div class="cal__out" id="cal-out" aria-live="polite"></div>

  <noscript>
    <div class="note">
      <p>
        <strong>This tool needs JavaScript.</strong> The same information is on the static
        zone pages — pick yours:
        {
          zones.map((z, i) => (
            <>
              {i > 0 && ', '}
              <a href={`/planting-calendar/zone-${z.zone}/`}>zone {z.zone}</a>
            </>
          ))
        }.
      </p>
    </div>
  </noscript>
</div>

<script>
  // Imports the same derivation the zone pages render with, so the tool and the
  // static pages can never disagree.
  import {
    zones, windowsFor, monthsFrom, successionFor, formatDay, SUCCESSION_EVERY_DAYS,
  } from '@/lib/calendar';

  const zoneSel = document.getElementById('cal-zone') as HTMLSelectElement | null;
  const monthSel = document.getElementById('cal-month') as HTMLSelectElement | null;
  const lfInput = document.getElementById('cal-lf') as HTMLInputElement | null;
  const ffInput = document.getElementById('cal-ff') as HTMLInputElement | null;
  const resetBtn = document.getElementById('cal-reset');
  const out = document.getElementById('cal-out');
  const meta = document.getElementById('cal-meta');

  if (zoneSel && monthSel && lfInput && ffInput && out && meta) {
    const STORE = 'htsavg:prefs';
    const CUM = [0, 31, 59, 90, 120, 151, 181, 212, 243, 273, 304, 334];

    /** "2026-04-20" -> day-of-year 110. Year is ignored. */
    const dayFromInput = (v: string): number | null => {
      const m = /^\d{4}-(\d{2})-(\d{2})$/.exec(v);
      if (!m) return null;
      const mon = Number(m[1]) - 1;
      const day = Number(m[2]);
      if (mon < 0 || mon > 11 || day < 1 || day > 31) return null;
      return CUM[mon] + day;
    };

    /** day-of-year -> "2026-04-20", for seeding the date inputs. */
    const inputFromDay = (d: number): string => {
      let mon = 11;
      while (mon > 0 && d <= CUM[mon]) mon--;
      const day = d - CUM[mon];
      return `2026-${String(mon + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
    };

    type Prefs = { zone?: string; lf?: string; ff?: string };
    const readPrefs = (): Prefs => {
      try {
        return JSON.parse(localStorage.getItem(STORE) || '{}');
      } catch {
        return {};
      }
    };
    const writePrefs = (p: Prefs) => {
      try {
        localStorage.setItem(STORE, JSON.stringify(p));
      } catch {
        /* private mode — the tool still works, it just will not remember */
      }
    };

    const prefs = readPrefs();
    if (prefs.zone && zones.some((z) => String(z.zone) === prefs.zone)) zoneSel.value = prefs.zone;
    monthSel.value = String(new Date().getMonth());

    const currentZone = () => zones.find((z) => String(z.zone) === zoneSel.value)!;

    /** Seed the date inputs from the selected zone unless the reader overrode them. */
    function syncDateInputs(force = false) {
      const z = currentZone();
      if (force || !lfInput!.value) lfInput!.value = inputFromDay(z.lastFrostDay);
      if (force || !ffInput!.value) ffInput!.value = inputFromDay(z.firstFrostDay);
    }

    if (prefs.lf) lfInput.value = prefs.lf;
    if (prefs.ff) ffInput.value = prefs.ff;

    // Zone pages link here with a city's NOAA dates: ?zone=8&last=03-15&first=11-20.
    // A link is an explicit choice, so it beats saved prefs. Malformed values are ignored.
    const params = new URLSearchParams(location.search);
    const qZone = params.get('zone');
    const qDate = (v: string | null) =>
      v && /^\d{2}-\d{2}$/.test(v) && dayFromInput(`2026-${v}`) !== null ? `2026-${v}` : null;
    const qLast = qDate(params.get('last'));
    const qFirst = qDate(params.get('first'));
    const fromLink = !!(qLast && qFirst);
    if (qZone && zones.some((z) => String(z.zone) === qZone)) {
      zoneSel.value = qZone;
      if (!fromLink) syncDateInputs(true);
    }
    if (fromLink) {
      lfInput.value = qLast!;
      ffInput.value = qFirst!;
    }
    syncDateInputs();

    const esc = (s: string) =>
      s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

    function render() {
      const z = currentZone();
      const lf = dayFromInput(lfInput!.value) ?? z.lastFrostDay;
      const ff = dayFromInput(ffInput!.value) ?? z.firstFrostDay;
      const custom = lf !== z.lastFrostDay || ff !== z.firstFrostDay;

      const season = ((ff - lf + 365) % 365) || 365;
      const months = monthsFrom(windowsFor(lf, ff), successionFor(lf, ff));
      const month = months[Number(monthSel!.value)];

      meta!.innerHTML = custom
        ? `Using <strong>your</strong> frost dates: last frost <strong>${esc(formatDay(lf))}</strong>, ` +
          `first frost <strong>${esc(formatDay(ff))}</strong> — about ${season} frost-free days.`
        : `Zone ${z.zone} averages its last spring frost around <strong>${esc(z.lastFrost)}</strong> ` +
          `and its first fall frost around <strong>${esc(z.firstFrost)}</strong>. ` +
          `<a href="/planting-calendar/zone-${z.zone}/">See the full zone ${z.zone} calendar</a>.`;

      if (!month || (month.entries.length === 0 && month.resow.length === 0)) {
        out!.innerHTML =
          `<p class="cal__empty">Nothing to sow outdoors in ` +
          `${esc(month ? month.name : '')} for these dates. Crops already in the ground keep ` +
          `growing. Use the time to plan beds, order seed, or start long-season crops under a ` +
          `light indoors.</p>`;
        return;
      }

      const rows = month.entries
        .map(
          (e) =>
            `<li><span class="cal__crop">${esc(e.crop.name)}</span>` +
            `<span class="cal__action">${esc(e.label)}</span>` +
            `<span class="cal__window">${esc(e.window)}</span></li>`
        )
        .join('');

      const resowRows = month.resow
        .map(
          (r) =>
            `<li><span class="cal__crop">${esc(r.crop.name)}</span>` +
            `<span class="cal__action">Re-sow every ${SUCCESSION_EVERY_DAYS} days` +
            (r.heatRisk ? ` <span class="pill pill--harder">may bolt in heat</span>` : '') +
            `</span>` +
            `<span class="cal__window">last sowing ${esc(formatDay(r.lastDay))}</span></li>`
        )
        .join('');

      out!.innerHTML =
        `<h3 class="mt-0">${esc(month.name)}${custom ? '' : ` in zone ${z.zone}`}</h3>` +
        `<ul class="cal__list">${rows}${resowRows}</ul>`;
    }

    function save() {
      const z = currentZone();
      const lf = lfInput!.value;
      const ff = ffInput!.value;
      writePrefs({
        zone: zoneSel!.value,
        // only persist dates that differ from the zone default
        lf: dayFromInput(lf) === z.lastFrostDay ? undefined : lf,
        ff: dayFromInput(ff) === z.firstFrostDay ? undefined : ff,
      });
    }

    zoneSel.addEventListener('change', () => {
      syncDateInputs(true);
      save();
      render();
    });
    monthSel.addEventListener('change', render);
    for (const el of [lfInput, ffInput]) {
      el.addEventListener('change', () => {
        save();
        render();
      });
    }
    resetBtn?.addEventListener('click', () => {
      syncDateInputs(true);
      save();
      render();
    });

    // If the reader arrived with custom dates, saved or linked, open the panel so it is obvious.
    if (prefs.lf || prefs.ff || fromLink) document.getElementById('cal-override')?.setAttribute('open', '');
    if (fromLink || qZone) save();

    render();
  }
</script>
