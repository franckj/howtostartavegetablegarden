---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import AnswerBox from '@/components/AnswerBox.astro';
import Toc from '@/components/Toc.astro';
import Faq from '@/components/Faq.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import NextSteps from '@/components/NextSteps.astro';
import {
  zones, crops, calendarForZone, cropRowsForZone, successionForZone, windowsForZone,
  zonesMeta, cropsMeta, formatDay, SUCCESSION_EVERY_DAYS, MONTHS,
} from '@/lib/calendar';
import {
  citiesForZone, citiesMeta, hasTypicalFrost, formatMonthDay, dayOfYear, toolLink,
} from '@/lib/cities';
import { GANTT_FULL, ganttPath, ganttOgPath } from '@/lib/gantt';
import { SITE, GUIDE_LINKS, faqSchema, breadcrumbSchema, humanDate } from '@/lib/site';

export const getStaticPaths: GetStaticPaths = () =>
  zones.map((zone) => ({ params: { zone: String(zone.zone) }, props: { zone } }));

const { zone } = Astro.props;
const path = `/planting-calendar/zone-${zone.zone}/`;
const dateModified = '2026-09-14';

const months = calendarForZone(zone);
const rows = cropRowsForZone(zone);
const runs = successionForZone(zone);
const runBySlug = new Map(runs.map((r) => [r.crop.slug, r]));
// A month counts as active if anything can be sown then — first window or re-sow.
const activeMonths = months.filter((m) => m.entries.length > 0 || m.resow.length > 0);
const idleMonths = months.filter((m) => m.entries.length === 0 && m.resow.length === 0);

const z = zone.zone;
const title = `Zone ${z} Planting Calendar (${z}a & ${z}b): Printable, by Month`;

const zoneCities = citiesForZone(z);
const typicalCities = zoneCities.filter((c) => hasTypicalFrost(c) && c.lastFrost.p50);
const rareFreezeCities = zoneCities.filter((c) => !hasTypicalFrost(c));

const description = `Zone ${z} (${z}a & ${z}b) planting dates for 12 vegetables: a printable chart, month-by-month tables and NOAA frost dates for ${zoneCities.length} zone ${z} cities.`;

const imageUrl = `${SITE.origin}${ganttPath(z)}`;
const imageAlt = `Zone ${z} vegetable planting calendar: indoor start, direct sow and transplant windows by month for ${crops.length} beginner crops`;

/** "3 weeks" / "10 days" between two day-of-year values. */
const gap = (days: number) =>
  days >= 14 ? `${Math.round(days / 7)} weeks` : `${days} day${days === 1 ? '' : 's'}`;

// Same zone, different frost dates — the whole point of the city table, computed.
const byLastFrost = [...typicalCities].sort(
  (a, b) => dayOfYear(a.lastFrost.p50!) - dayOfYear(b.lastFrost.p50!)
);
const earliestCity = byLastFrost[0];
const latestCity = byLastFrost.at(-1);
const frostSpreadDays =
  earliestCity && latestCity && earliestCity !== latestCity
    ? dayOfYear(latestCity.lastFrost.p50!) - dayOfYear(earliestCity.lastFrost.p50!)
    : 0;
const cityLabel = (c: { city: string; state: string; subzone: string | null }) =>
  `${c.city}, ${c.state} (${c.subzone})`;

const bySeason = zoneCities
  .filter((c) => c.frostFreeDays !== null && hasTypicalFrost(c))
  .sort((a, b) => a.frostFreeDays! - b.frostFreeDays!);
const shortSeason = bySeason[0];
const longSeason = bySeason.at(-1);

// Month and fall FAQs are generated from the same month plan as the tables below.
const july = months[6];
const listCrops = (names: string[]) =>
  names.length <= 2 ? names.join(' and ') : `${names.slice(0, -1).join(', ')} and ${names.at(-1)}`;
const julyByAction = new Map<string, string[]>();
for (const e of july.entries) {
  const label = e.fall ? 'sow for a fall crop' : e.label.toLowerCase();
  julyByAction.set(label, [...(julyByAction.get(label) ?? []), e.crop.name.toLowerCase()]);
}
const julyResow = july.resow.map((r) => r.crop.name.toLowerCase());
const julyAnswer =
  july.entries.length === 0 && july.resow.length === 0
    ? `Nothing needs sowing outdoors in July in zone ${z}. Keep harvesting what is already in the ground, and plan the fall beds.`
    : `In zone ${z}, July plantings are: ` +
      [
        ...[...julyByAction].map(([action, names]) => `${action} &mdash; ${listCrops([...new Set(names)])}`),
        ...(julyResow.length ? [`re-sow every ${SUCCESSION_EVERY_DAYS} days &mdash; ${listCrops(julyResow)}`] : []),
      ].join('; ') +
      `. The <a href="#july">July table</a> gives the exact window for each.` +
      (july.resow.some((r) => r.heatRisk) ? ' Cool-season sowings in July may bolt in the heat.' : '');

const fallWindows = windowsForZone(zone).filter((w) => w.fall).sort((a, b) => a.startDay - b.startDay);
const fallFirst = fallWindows[0];
const fallLast = [...fallWindows].sort((a, b) => a.endDay - b.endDay).at(-1);

const monthHasPlanting = (i: number) => months[i].entries.length > 0 || months[i].resow.length > 0;

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Planting calendar', path: '/planting-calendar/' },
  { name: `Zone ${zone.zone}`, path },
];

const tocItems = [
  { id: 'chart', label: `Zone ${zone.zone} planting chart` },
  { id: 'month-by-month', label: 'Month by month' },
  { id: 'crop-by-crop', label: 'Every crop, sowing to harvest' },
  { id: 'sub-zones', label: `Zone ${zone.zone}a vs ${zone.zone}b` },
  { id: 'city-frost-dates', label: `Frost dates for cities in zone ${zone.zone}` },
  { id: 'notes', label: `Growing in zone ${zone.zone}` },
];

/** Zones 3-5 thaw late enough that the frost date alone is actively misleading. */
const coldZone = zone.zone <= 5;


const faqs = [
  {
    q: `When is the last frost in zone ${zone.zone}?`,
    a: `Zone ${zone.zone} is conventionally taken to average its last spring frost around ${zone.lastFrost} and its first fall frost around ${zone.firstFrost}, giving roughly ${zone.seasonDays} frost-free days. Be aware that a hardiness zone is defined by winter minimum temperature, not by frost dates — these are widely-used approximations, not official USDA figures. Get your real dates from the NOAA freeze-date map or your county cooperative extension office.`,
  },
  {
    q: `What can I plant now in zone ${zone.zone}?`,
    a: `Use the month-by-month table on this page. The pattern is: frost-tolerant crops like peas, spinach and radishes go in 6 to 2 weeks before ${zone.lastFrost}; warm-season crops like beans, zucchini and tomatoes go in 1 to 3 weeks after it; and cool-season crops get a second sowing about 10 to 12 weeks before ${zone.firstFrost}.`,
  },
  {
    q: `Can I grow tomatoes in zone ${zone.zone}?`,
    a: `Yes. In zone ${zone.zone}, start tomato seed indoors 6 to 8 weeks before ${zone.lastFrost} or buy a seedling, then transplant 1 to 2 weeks after the last frost once nights stay above 50&deg;F. With ${zone.seasonDays} frost-free days there is ${zone.seasonDays < 140 ? 'enough season for early and mid-season varieties, though large beefsteak types are a gamble — choose cherry or early varieties rated under 70 days' : 'comfortable room for any variety, including large beefsteak types'}.`,
  },
  {
    q: `How many harvests can I get in zone ${zone.zone}?`,
    a: `${zone.seasonDays < 140 ? 'One main round plus a tight fall sowing of the fastest crops. Radishes, spinach and lettuce can still be squeezed in after an early crop comes out.' : zone.seasonDays < 220 ? 'Two full rounds: a spring planting of cool-season crops, a summer planting of warm-season crops, and a fall sowing of greens and roots in the same beds.' : 'Two to three rounds a year, with the cool-season crops moved to autumn and late winter rather than midsummer, when heat rather than frost becomes the limiting factor.'}`,
  },
  {
    q: `Does a raised bed change these dates in zone ${zone.zone}?`,
    a: 'Yes, in spring. A raised bed warms 2 to 3 weeks earlier than open ground, so you can bring the early sowings forward by up to two weeks. Autumn dates are unchanged, since the first frost arrives on the same day regardless of your setup.',
  },
  {
    q: `What is the difference between zone ${z}a and ${z}b?`,
    a: `Five degrees in the average coldest night of the year. Zone ${z}a averages ${zone.subzones.a}&deg;F at its coldest and zone ${z}b ${zone.subzones.b}&deg;F. The letter matters for perennials on the edge of winter hardiness. It does not change vegetable planting dates, which follow your frost dates &mdash; the calendar on this page applies to both halves.`,
  },
  {
    q: `Is zone ${z}a or ${z}b better for tomatoes?`,
    a:
      `Neither &mdash; the letter does not decide it. ${z}a and ${z}b differ only in how cold the coldest winter night gets, and tomatoes grow in summer, long after that night has passed. What matters is the length of your frost-free season.` +
      (shortSeason && longSeason && shortSeason !== longSeason
        ? ` Within zone ${z}, ${cityLabel(longSeason)} averages ${longSeason.frostFreeDays} frost-free days and ${cityLabel(shortSeason)} only ${shortSeason.frostFreeDays}.`
        : '') +
      ' Check the city table on this page, or enter your own frost dates in the calendar.',
  },
  {
    q: `What can I plant in July in zone ${z}?`,
    a: julyAnswer,
  },
  ...(fallFirst && fallLast
    ? [{
        q: `When does fall planting start in zone ${z}?`,
        a:
          `Sowings for a fall harvest in zone ${z} start around ${formatDay(fallFirst.startDay)} with ${fallFirst.crop.name.toLowerCase()} and run to about ${formatDay(fallLast.endDay)} with ${fallLast.crop.name.toLowerCase()}. Each date is counted back from the average first frost (${zone.firstFrost}) by the crop's days to harvest plus two weeks, so a crop sown on time matures before the cold arrives.` +
          (fallFirst.startDay < 182
            ? ` That puts the slowest crops in before midsummer: with the first frost in ${zone.firstFrost.split(' ')[0]}, a fall ${fallFirst.crop.name.toLowerCase()} crop has to be sown while it still feels like spring.`
            : ''),
      }]
    : []),
  {
    q: `Is there a printable PDF of the zone ${z} planting calendar?`,
    a: `Not as a download yet. The chart and the month-by-month tables on this page print cleanly &mdash; use your browser's Print command and the menus, ads and questions are left off the page. A downloadable version is on the way.`,
  },
];

const zoneSchema = {
  '@type': 'Dataset',
  '@id': `${SITE.origin}${path}#dataset`,
  name: `Zone ${zone.zone} vegetable planting windows`,
  description: `Sowing, transplanting and harvest windows for 12 beginner vegetable crops in USDA hardiness zone ${zone.zone}, derived from an average last frost of ${zone.lastFrost} and first frost of ${zone.firstFrost}.`,
  url: `${SITE.origin}${path}`,
  license: 'https://creativecommons.org/licenses/by/4.0/',
  creator: { '@id': `${SITE.origin}/#organization` },
  isPartOf: { '@id': `${SITE.origin}/planting-calendar/#dataset` },
  dateModified,
  isAccessibleForFree: true,
  spatialCoverage: { '@type': 'Place', name: `USDA hardiness zone ${zone.zone}, United States` },
  image: { '@id': `${SITE.origin}${path}#calendar-image` },
};

const imageSchema = {
  '@type': 'ImageObject',
  '@id': `${SITE.origin}${path}#calendar-image`,
  contentUrl: imageUrl,
  url: imageUrl,
  width: GANTT_FULL.width,
  height: GANTT_FULL.height,
  caption: imageAlt,
  encodingFormat: 'image/png',
  license: 'https://creativecommons.org/licenses/by/4.0/',
  acquireIfPossible: `${SITE.origin}/about/`,
  creditText: SITE.name,
  creator: { '@id': `${SITE.origin}/#organization` },
  copyrightNotice: SITE.name,
};
---

<BaseLayout
  {title}
  {description}
  {path}
  {dateModified}
  schema={[zoneSchema, imageSchema, faqSchema(faqs), breadcrumbSchema(crumbs)]}
  ogImage={ganttOgPath(z)}
>
  <Breadcrumbs items={crumbs} />

  <div class="wrap page-head prose">
    <p class="eyebrow">Planting calendar</p>
    <h1>{title}</h1>
    <p class="updated">Last updated {humanDate(dateModified)}</p>
  </div>

  <div class="wrap prose">
    <AnswerBox label={`Zone ${zone.zone} at a glance`}>
      <p>
        Zone {zone.zone} runs winter lows of {zone.minTempF}&deg;F, and is conventionally
        taken to average its last spring frost around <strong>{zone.lastFrost}</strong> and
        its first fall frost around <strong>{zone.firstFrost}</strong> — about
        <strong>{zone.seasonDays} frost-free days</strong>. {zone.summary}
      </p>
      <p>
        Sow frost-tolerant crops (peas, spinach, radishes, lettuce, kale, carrots) 6 to 2 weeks
        before {zone.lastFrost}. Plant warm-season crops (beans, zucchini, cucumbers, tomatoes,
        peppers) 1 to 3 weeks after it. Sow a second round of greens and roots about 10 to 12
        weeks before {zone.firstFrost}.
      </p>
    </AnswerBox>

    <Toc items={tocItems} ordered={false} />

    <p>
      Typical regions in zone {zone.zone}: {zone.regions}.
    </p>

    <h2 id="chart">Zone {z} planting chart</h2>
    <figure class="zone-chart">
      <a href={ganttPath(z)}>
        <img
          src={ganttPath(z)}
          alt={imageAlt}
          width={GANTT_FULL.width}
          height={GANTT_FULL.height}
          loading="lazy"
          decoding="async"
        />
      </a>
      <figcaption>
        Every sowing window for zone {z} on one page, drawn from the same data as the tables
        below. Dashed lines mark the average last frost ({zone.lastFrost}) and first frost
        ({zone.firstFrost}).
      </figcaption>
    </figure>

    <nav class="month-nav" aria-label={`Zone ${z} months`}>
      {
        MONTHS.map((name, i) => (
          <a href={`#${name.toLowerCase()}`} class={monthHasPlanting(i) ? undefined : 'month-nav__idle'}>
            {name.slice(0, 3)}
          </a>
        ))
      }
    </nav>

    <h2 id="month-by-month">Month by month in zone {zone.zone}</h2>
    <p>
      {activeMonths.length} of the 12 months have something to plant in zone {zone.zone}. Rows
      marked <em>re-sow</em> are succession sowings — the same crop planted again every{' '}
      {SUCCESSION_EVERY_DAYS} days for a continuous harvest, up to the last date it can still
      mature before {zone.firstFrost}.
    </p>

    {
      months.map((m) =>
        m.entries.length === 0 && m.resow.length === 0 ? (
          <>
            <h3 id={m.name.toLowerCase()}>{m.name}</h3>
            <p class="month-idle">
              Nothing to sow outdoors in {m.name} in zone {z}. Crops already in the ground keep
              growing and keep being harvested.
            </p>
          </>
        ) : (
          <>
            <h3 id={m.name.toLowerCase()}>{m.name}</h3>
            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th scope="col">Crop</th>
                    <th scope="col">What to do</th>
                    <th scope="col">Window</th>
                  </tr>
                </thead>
                <tbody>
                  {m.entries.map((e) => (
                    <tr>
                      <th scope="row">
                        {e.crop.name}
                      </th>
                      <td style="white-space:normal">{e.label}</td>
                      <td>{e.window}</td>
                    </tr>
                  ))}
                  {m.resow.map((r) => (
                    <tr>
                      <th scope="row">
                        {r.crop.name}
                      </th>
                      <td style="white-space:normal">
                        Re-sow every {SUCCESSION_EVERY_DAYS} days
                        {r.heatRisk && (
                          <>
                            {' '}<span class="pill pill--harder">may bolt in heat</span>
                          </>
                        )}
                      </td>
                      <td>last sowing {formatDay(r.lastDay)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </>
        )
      )
    }

    {
      idleMonths.length > 0 && (
        <div class="note">
          <p>
            <strong>
              Nothing to sow outdoors in{' '}
              {idleMonths.map((m) => m.name).join(', ')} in zone {zone.zone}.
            </strong>{' '}
            Use the time to plan beds, order seed, build a compost pile, or start long-season
            crops under a light indoors.
          </p>
        </div>
      )
    }

    <h2 id="crop-by-crop">Every crop, sowing to harvest</h2>
    <p>
      One row per crop, with the indoor start where it applies, the outdoor planting window,
      the second fall sowing where the season allows it, and the earliest realistic harvest.
    </p>
    <div class="table-wrap">
      <table>
        <caption>
          Harvest dates assume the earliest outdoor planting in the window and the crop's
          published days-to-harvest range. Weather moves all of it.
        </caption>
        <thead>
          <tr>
            <th scope="col">Crop</th>
            <th scope="col">Start indoors</th>
            <th scope="col">Plant outdoors</th>
            <th scope="col">Fall sowing</th>
            <th scope="col">Re-sow until</th>
            <th scope="col">Harvest from</th>
          </tr>
        </thead>
        <tbody>
          {
            rows.map((r) => (
              <tr>
                <th scope="row">
                  {r.crop.name}
                </th>
                <td>{r.indoors ?? '-'}</td>
                <td style="white-space:normal">{r.outdoors}</td>
                <td>{r.fall ?? '-'}</td>
                <td>
                  {runBySlug.has(r.crop.slug)
                    ? formatDay(runBySlug.get(r.crop.slug)!.lastDay)
                    : '-'}
                </td>
                <td>{r.harvest}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <h2 id="sub-zones">Zone {z}a vs {z}b: what the letter means</h2>
    <p>
      Zone {z} covers places whose coldest night of the year averages {zone.minTempF}&deg;F.
      USDA splits it into two 5-degree halves: <strong>{z}a</strong> ({zone.subzones.a}&deg;F)
      and <strong>{z}b</strong> ({zone.subzones.b}&deg;F).
    </p>
    <p>
      The letter tells you about winter survival &mdash; whether a perennial left in the ground
      makes it through the coldest night. It says nothing about when your last spring frost
      arrives, and that date decides every sowing window on this page.
      {
        frostSpreadDays >= 7 && earliestCity && latestCity && (
          <>
            {' '}{cityLabel(earliestCity)} and {cityLabel(latestCity)} are both zone {z}, yet their
            typical last frosts are {gap(frostSpreadDays)} apart:{' '}
            {formatMonthDay(earliestCity.lastFrost.p50!)} and {formatMonthDay(latestCity.lastFrost.p50!)}.
          </>
        )
      }
      {
        rareFreezeCities.length > 0 && (
          <>
            {' '}And in {cityLabel(rareFreezeCities[0])},{' '}
            {rareFreezeCities[0].freezeChancePct === 0
              ? 'a 32°F freeze almost never happens at all.'
              : `a freeze happens in only ${rareFreezeCities[0].freezeChancePct}% of years.`}
          </>
        )
      }
    </p>
    <p>
      So for vegetables, ignore the letter. Find the frost dates for the weather station nearest
      you &mdash; the table below covers {zoneCities.length} zone {z} cities &mdash; and enter them in
      the <a href="/planting-calendar/">interactive calendar</a>. Every window recalculates from
      your dates.
    </p>

    <h2 id="city-frost-dates">Frost dates for cities in zone {z}</h2>
    <p>
      Same zone, frost dates weeks apart &mdash; which is why the calendar asks for your own dates
      rather than trusting the zone.
    </p>
    <div class="frost-table">
      <input type="checkbox" id={`ft-all-${z}`} class="frost-table__toggle" />
      <label for={`ft-all-${z}`} class="frost-table__toggle-label">Show safer 30% and 10% dates</label>
      <div class="table-wrap">
        <table>
          <caption>
            NOAA 1991&ndash;2020 normals for each city's weather station (usually the airport).
            The <strong>typical</strong> date has a 50% chance of frost after it in spring, or
            before it in fall; at <strong>10%</strong> the risk is 1 year in 10.
          </caption>
          <thead>
            <tr>
              <th scope="col">City</th>
              <th scope="col">Zone</th>
              <th scope="col">Last frost</th>
              <th scope="col" class="ft-extra">30%</th>
              <th scope="col" class="ft-extra">10%</th>
              <th scope="col">First frost</th>
              <th scope="col" class="ft-extra">30%</th>
              <th scope="col" class="ft-extra">10%</th>
              <th scope="col">Frost-free days</th>
            </tr>
          </thead>
          <tbody>
            {
              zoneCities.map((c) => {
                const link = toolLink(c, z);
                const d = (v: string | null) => (v ? formatMonthDay(v) : '');
                return (
                  <tr>
                    <th scope="row">
                      {c.city}, {c.state}
                      <span class="ft-station">
                        <a href={c.source} rel="noopener" target="_blank">{c.station.name.replace(/, [A-Z]{2} US$/, '').toLowerCase()}</a>
                        {c.freezeChancePct !== null && c.freezeChancePct < 95 && hasTypicalFrost(c) && (
                          <> &middot; freezes in {c.freezeChancePct}% of years</>
                        )}
                      </span>
                      {link && <a class="ft-use" href={link}>Use these dates</a>}
                    </th>
                    <td>{c.subzone}</td>
                    {hasTypicalFrost(c) ? (
                      <>
                        <td>{d(c.lastFrost.p50)}</td>
                        <td class="ft-extra">{d(c.lastFrost.p30)}</td>
                        <td class="ft-extra">{d(c.lastFrost.p10)}</td>
                        <td>{d(c.firstFrost.p50)}</td>
                        <td class="ft-extra">{d(c.firstFrost.p30)}</td>
                        <td class="ft-extra">{d(c.firstFrost.p10)}</td>
                      </>
                    ) : (
                      <td colspan="6" class="ft-rare">
                        {c.freezeChancePct === 0
                          ? 'A 32°F freeze almost never happens here — no frost date'
                          : `Freezes in only ${c.freezeChancePct}% of years — no typical frost date`}
                      </td>
                    )}
                    <td>{c.frostFreeDays === 365 ? '365 (year-round)' : c.frostFreeDays ?? ''}</td>
                  </tr>
                );
              })
            }
          </tbody>
        </table>
      </div>
    </div>
    <p class="ft-sources">
      Sources: {
        citiesMeta.sources.map((src, i) => (
          <>
            {i > 0 && '; '}
            <a href={src.url} rel="noopener" target="_blank">{src.name}</a>
          </>
        ))
      }. The zone shown is read from the 2023 USDA map at each station's location.
    </p>

    <h2 id="notes">Growing in zone {zone.zone}</h2>
    <p>{zone.summary}</p>

    <div class="note">
      <p>
        <strong>Soil beats calendar.</strong> Extension guidance for the hardiest crops is
        &ldquo;as soon as the soil can be worked&rdquo; or &ldquo;as soon as the soil
        thaws&rdquo; &mdash; not a fixed date. If you cannot crumble a handful of soil in your
        fist, wait, whatever the table says. Warm-season crops have a matching rule: beans want
        60&deg;F soil, cucumbers and squash 70&deg;F.
      </p>
    </div>

    {
      coldZone && (
        <div class="note">
          <p>
            <strong>This matters most in zone {zone.zone}.</strong> The earliest spring windows
            above assume the ground has thawed and is workable, and in a late spring it may
            still be frozen or waterlogged on those dates. A raised bed, which warms 2 to 3
            weeks earlier than open ground, is the reliable way to hit the early dates here.
          </p>
        </div>
      )
    }

    {
      zone.zone >= 8 && (
        <div class="note">
          <p>
            <strong>Heat is your limiting factor, not frost.</strong> With {zone.seasonDays}{' '}
            frost-free days, the hard part of the zone {zone.zone} year is midsummer. Lettuce
            and spinach bolt bitter above 80&deg;F, so move them to autumn and late winter
            rather than fighting July. The fall sowing dates above are the important ones here.
          </p>
        </div>
      )
    }

    <div class="note">
      <p>
        <strong>About the bolting warnings.</strong> Cool-season crops run to seed and turn
        bitter in summer heat. The &ldquo;may bolt in heat&rdquo; flag above is a rough
        calendar rule &mdash; mid-June to the start of September, the same window across the
        whole country &mdash; because a hardiness zone carries no summer-temperature
        information at all. In zone {zone.zone} treat it as {zone.zone <= 4
          ? 'cautious; summers here are mild enough that midsummer sowings often succeed'
          : zone.zone >= 8
            ? 'understated; your hot spell starts earlier and runs later, and heat-tolerant varieties plus afternoon shade matter'
            : 'about right, with heat-tolerant varieties and afternoon shade extending it either side'}.
      </p>
    </div>

    <div class="note">
      <p><strong>Where these dates come from.</strong> {zonesMeta.note}</p>
      <p>
        You can enter your own frost dates in the
        <a href="/planting-calendar/">interactive calendar</a> and every window on it
        recalculates from your numbers. Look up your local averages on the
        <a
          href="https://www.climate.gov/news-features/understanding-climate/interactive-map-average-date-last-spring-freeze-across-united"
          rel="noopener"
          target="_blank">NOAA last-spring-freeze map</a
        >. Note that an &ldquo;average&rdquo; frost date is the point where the chance of
        freezing drops below 50 percent, so for tender crops it is worth waiting a week or two
        past it.
      </p>
    </div>

    <p>
      Other zones: {
        zones
          .filter((z) => z.zone !== zone.zone)
          .map((z, i) => (
            <>
              {i > 0 && ', '}
              <a href={`/planting-calendar/zone-${z.zone}/`}>zone {z.zone}</a>
            </>
          ))
      }. Or use the <a href="/planting-calendar/">interactive calendar</a> to check a single
      month.
    </p>

    <Faq faqs={faqs} heading={`Zone ${zone.zone} questions`} />

    <NextSteps links={GUIDE_LINKS.filter((g) => g.href !== '/planting-calendar/')} heading="Keep going" />
  </div>
</BaseLayout>
