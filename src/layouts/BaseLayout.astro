---
import '@/styles/tokens.css';
import '@/styles/global.css';
import { SITE, NAV, NAV_CTA, FOOTER_LEGAL, GUIDE_LINKS, humanDate } from '@/lib/site';
import { lastChanged, SITE_CONTENT_PATHS } from '@/lib/updated';

interface Props {
  title: string;
  description: string;
  path: string;
  /** ISO date, e.g. "2026-07-30" */
  dateModified?: string;
  /** Extra JSON-LD nodes merged into the sitewide @graph. */
  schema?: unknown[];
  ogType?: 'website' | 'article';
  noindex?: boolean;
  /** Site-relative og:image path; defaults to the sitewide card. */
  ogImage?: string;
}

const {
  title,
  description,
  path,
  dateModified = lastChanged(SITE_CONTENT_PATHS),
  schema = [],
  ogType = 'article',
  noindex = false,
  ogImage: ogImagePath = '/og-image.png',
} = Astro.props;

const canonical = `${SITE.origin}${path}`;
/** Footer date: the latest content change anywhere on the site. The page's own date sits under its H1. */
const siteUpdated = lastChanged(SITE_CONTENT_PATHS);
const ogImage = `${SITE.origin}${ogImagePath}`;

const isHome = path === '/';

/**
 * The site name Google shows in results comes from this WebSite node first,
 * then og:site_name, then <title>. Google states it must be on the home page —
 * "the domain or subdomain root URI, not subdirectories" — so it is emitted
 * there only. Other pages still reference it by @id, which is fine.
 *
 * Since 2026-09-14 the brand name IS the domain in camel case
 * ("HowToStartaVegetableGarden.com", Franck's call). `alternateName` carries the
 * spaced form as Google's fallback — never the all-lowercase domain.
 */
const websiteNode = {
  '@type': 'WebSite',
  '@id': `${SITE.origin}/#website`,
  url: `${SITE.origin}/`,
  name: SITE.name,
  alternateName: SITE.alternateName,
  description: SITE.tagline,
  inLanguage: 'en-US',
  publisher: { '@id': `${SITE.origin}/#organization` },
};

const graph = [
  ...(isHome ? [websiteNode] : []),
  {
    '@type': 'Organization',
    '@id': `${SITE.origin}/#organization`,
    name: SITE.name,
    url: `${SITE.origin}/`,
    email: SITE.email,
    description: SITE.tagline,
  },
  {
    '@type': 'WebPage',
    '@id': `${canonical}#webpage`,
    url: canonical,
    name: title,
    description,
    isPartOf: { '@id': `${SITE.origin}/#website` },
    dateModified,
    inLanguage: 'en-US',
  },
  ...schema,
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex,follow" />}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- .ico first and by its conventional name: Google Search looks for
         /favicon.ico and often falls back to a generic globe when only an SVG
         icon is declared. The 48px entry inside it is Google's stated minimum. -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon-96.png" type="image/png" sizes="96x96" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })}
    />

    <!-- Google AdSense. is:inline keeps it a plain async script tag; Astro would
         otherwise bundle it as a module and Google's crawler would not find the
         tag it looks for during site review. Rendered only when a publisher ID is
         set, and never on noindex pages (the 404). -->
    {
      SITE.adsensePublisherId && !noindex && (
        <script
          is:inline
          async
          src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${SITE.adsensePublisherId}`}
          crossorigin="anonymous"
        />
      )
    }

    <!-- Privacy-friendly analytics by Plausible. is:inline keeps the queue shim as a
         classic script so plausible.init() runs before the async script lands. -->
    <script is:inline async src={SITE.plausibleScript}></script>
    <script is:inline>
      window.plausible =
        window.plausible ||
        function () {
          (plausible.q = plausible.q || []).push(arguments);
        };
      plausible.init =
        plausible.init ||
        function (i) {
          plausible.o = i || {};
        };
      plausible.init();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="wrap site-header__inner">
        <a class="brand" href="/">
          <svg
            class="brand__mark"
            width="34"
            height="34"
            viewBox="0 0 24 24"
            fill="none"
            aria-hidden="true">
            <path
              d="M12 21c0-5 0-8 0-8"
              stroke="#7a5330"
              stroke-width="1.8"
              stroke-linecap="round"></path>
            <path
              d="M12 13c-4.2 0-6.6-2.4-6.6-6.2C9.6 6.8 12 9.2 12 13Z"
              fill="#2f6b3f"></path>
            <path
              d="M12 13c4.2 0 6.6-2.4 6.6-6.2C14.4 6.8 12 9.2 12 13Z"
              fill="#3f8a52"></path>
          </svg>
          {/* Two deliberate lines rather than relying on where the text happens to wrap. */}
          <span class="brand__name">
            <span>How to Start a</span>
            <span>Vegetable Garden</span>
          </span>
        </a>

        <div class="site-header__right">
          <nav class="nav" aria-label="Primary">
            {NAV.map((item) => <a href={item.href}>{item.label}</a>)}
          </nav>
          <a class="btn btn--cta" href={NAV_CTA.href}>{NAV_CTA.label}</a>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="site-footer__grid">
          <div>
            <h2>Guides</h2>
            <ul>
              {GUIDE_LINKS.map((g) => <li><a href={g.href}>{g.title}</a></li>)}
            </ul>
          </div>
          <div>
            <h2>Site</h2>
            <ul>
              {FOOTER_LEGAL.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
            </ul>
          </div>
          <div class="site-footer__sig">
            <h2>About this site</h2>
            <p>
              Everyone who grows food started out killing a few plants. This site is here to
              make your first season kinder than that &mdash; plain steps, real numbers, and no
              assumption that you already know what any of it means.
            </p>
          </div>
        </div>

        <p class="site-footer__disclosure">
          There can be ads and affiliate links on this site to support the making of the
          website. They never change what we recommend, and anything affiliate-linked is
          labelled where it appears.
        </p>

        <div class="site-footer__base">
          <span>&copy; {new Date().getFullYear()} {SITE.name}</span>
          <span>Site last updated {humanDate(siteUpdated)}</span>
        </div>
      </div>
    </footer>
  </body>
</html>
