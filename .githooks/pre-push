#!/usr/bin/env bash
#
# Build and deploy before every push, so the live site can never silently lag
# the repo. Cloudflare Pages here is a direct-upload project — pushing to GitHub
# does not deploy on its own.
#
# Escape hatches:
#   SKIP_DEPLOY=1 git push     push without deploying (docs-only changes, etc.)
#   git push --no-verify       skip this hook entirely
#
# Versioned via `git config core.hooksPath .githooks` (see README).
set -euo pipefail

PROJECT="howtostartavegetablegarden"
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [ "${SKIP_DEPLOY:-}" = "1" ]; then
  echo "pre-push: SKIP_DEPLOY=1 — pushing without deploying."
  exit 0
fi

cd "$ROOT"

# Deploy only when the push actually touches main; branch pushes just build.
DEPLOY=0
while read -r _local_ref local_sha remote_ref _remote_sha; do
  # all-zero local sha means a branch delete — nothing to build
  case "$local_sha" in *[!0]*) ;; *) continue ;; esac
  case "$remote_ref" in refs/heads/main) DEPLOY=1 ;; esac
done

echo "pre-push: building..."
if ! npm run build --silent; then
  echo "pre-push: BUILD FAILED — push aborted so the repo never holds a broken build." >&2
  echo "          Fix the build, or use 'git push --no-verify' to override." >&2
  exit 1
fi

if [ "$DEPLOY" -ne 1 ]; then
  echo "pre-push: build OK. Not main, so nothing deployed."
  exit 0
fi

echo "pre-push: deploying to Cloudflare Pages ($PROJECT)..."
if ! npx wrangler pages deploy dist --project-name "$PROJECT" --branch main; then
  echo "pre-push: DEPLOY FAILED — push aborted so the repo does not get ahead of live." >&2
  echo "          If wrangler needs re-authentication, run 'npx wrangler login' and retry." >&2
  echo "          To push anyway: SKIP_DEPLOY=1 git push" >&2
  exit 1
fi

echo "pre-push: deployed. Proceeding with push."
