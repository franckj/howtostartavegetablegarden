---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AnswerBox from '@/components/AnswerBox.astro';
import Faq from '@/components/Faq.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import CalendarTool from '@/components/CalendarTool.astro';
import {
  zones, crops, zonesMeta, cropsMeta, dataSources, SUCCESSION_EVERY_DAYS,
} from '@/lib/calendar';
import { SITE, faqSchema, breadcrumbSchema, humanDate } from '@/lib/site';
import { lastChanged } from '@/lib/updated';

const path = '/planting-calendar/';
const dateModified = lastChanged(
  ['src/pages/planting-calendar/index.astro', 'src/components/CalendarTool.astro', 'src/data/zones.json', 'src/data/crops.json', 'src/lib/calendar.ts'],
  '2026-07-31'
);

const title = 'Vegetable Planting Calendar by USDA Zone (3-10)';
const description =
  'Pick your USDA zone and month to see what to sow indoors, direct sow or transplant. Covers 12 beginner crops across zones 3 to 10.';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Planting calendar', path },
];

const faqs = [
  {
    q: 'How do I find my USDA hardiness zone?',
    a: 'Enter your ZIP code on the USDA Plant Hardiness Zone Map at planthardiness.ars.usda.gov. The map was revised in 2023, so a zone you looked up more than a few years ago may have shifted about half a zone warmer.',
  },
  {
    q: 'What does my hardiness zone actually tell me?',
    a: 'Only your average annual <em>extreme minimum winter</em> temperature, in 10&deg;F bands. It is a winter-survival rating for perennials — it is not a frost-date band, and it says nothing about summer heat, humidity or rainfall. A zone 8 in Texas and a zone 8 in Oregon share a winter low and face completely different summers.',
  },
  {
    q: 'If zones are not frost dates, why use a zone at all?',
    a: 'Because it is a reasonable first guess and most people know their zone, while few know their frost dates. But a zone is genuinely a proxy here, not a source. If you have your local averages — from the NOAA freeze-date map or your county extension office — enter them in the tool above and every window recalculates from your numbers instead of ours.',
  },
  {
    q: 'Are these planting dates exact?',
    a: 'No, and no zone-based calendar can be. A single zone spans hundreds of miles, elevation alone can shift a frost date by two weeks, and the "average last frost" is by definition the date the chance of freezing drops below 50 percent — so planting on it is close to a coin flip. For tender crops, waiting a week or two past it is the safer read.',
  },
  {
    q: 'What is the difference between direct sowing and starting indoors?',
    a: 'Direct sowing means planting seed straight into its final position outdoors, which suits fast crops and anything root-based. Starting indoors means germinating under a light 6 to 12 weeks early and transplanting later, which is only worth it for long-season crops like tomatoes, peppers and onions.',
  },
  {
    q: 'Can I plant a second crop in the same season?',
    a: 'Yes, and the calendar shows it as "re-sow" rows. Radishes, lettuce, spinach, kale, carrots and bush beans are all worth sowing again every 14 days for a continuous harvest rather than one glut, right up to the last date each crop can still mature before your first fall frost. Cool-season crops sown into midsummer are flagged, because they bolt in heat.',
  },
  {
    q: 'What is succession planting?',
    a: 'Sowing a short row of the same crop every couple of weeks instead of the whole packet at once, so you harvest steadily rather than getting everything in one week. University of Maryland Extension puts it as planting "a portion of that space every two weeks". It is the single easiest way to get more out of a small bed.',
  },
  {
    q: 'Why does the calendar for zones 9 and 10 look inverted?',
    a: 'Because it is. In zones 9 and 10 the limiting factor is summer heat rather than winter frost, so the prime season for greens and root crops runs from autumn through early spring, and June to September is the hard part of the year.',
  },
];

const datasetSchema = {
  '@type': 'Dataset',
  '@id': `${SITE.origin}${path}#dataset`,
  name: 'US vegetable planting windows by USDA hardiness zone',
  description:
    'Sowing, transplanting and harvest windows for 12 common beginner vegetable crops across USDA hardiness zones 3 to 10, derived from average last-spring and first-fall frost dates.',
  url: `${SITE.origin}${path}`,
  license: 'https://creativecommons.org/licenses/by/4.0/',
  creator: { '@id': `${SITE.origin}/#organization` },
  dateModified,
  isAccessibleForFree: true,
  keywords: [
    'planting calendar',
    'USDA hardiness zone',
    'frost dates',
    'vegetable gardening',
    'sowing dates',
  ],
  spatialCoverage: { '@type': 'Place', name: 'United States' },
  variableMeasured: [
    'USDA hardiness zone',
    'average last spring frost date',
    'average first fall frost date',
    'frost-free days',
    'indoor sowing window',
    'direct sowing window',
    'transplant window',
    'fall sowing window',
    'days to harvest',
  ],
  distribution: [
    {
      '@type': 'DataDownload',
      encodingFormat: 'text/html',
      contentUrl: `${SITE.origin}${path}`,
    },
  ],
};
---

<BaseLayout
  {title}
  {description}
  {path}
  {dateModified}
  schema={[datasetSchema, faqSchema(faqs), breadcrumbSchema(crumbs)]}
>
  <Breadcrumbs items={crumbs} />

  <div class="wrap page-head prose">
    <p class="eyebrow">Free tool</p>
    <h1>Vegetable Planting Calendar by USDA Zone</h1>
    <p class="updated">Last updated {humanDate(dateModified)}</p>
  </div>

  <div class="wrap prose">
    <AnswerBox label="How to use this">
      <p>
        Pick your USDA hardiness zone and a month to see exactly what to start indoors,
        direct sow or transplant that month. Windows are calculated from each zone's average
        last spring frost and first fall frost, across the 12 crops most first gardens grow.
      </p>
      <p>
        Do not know your zone? Enter your ZIP code on the
        <a
          href="https://planthardiness.ars.usda.gov/"
          rel="noopener"
          target="_blank">USDA Plant Hardiness Zone Map</a
        >, last revised in 2023.
      </p>
      <p>
        One caveat worth reading before you plant anything: a hardiness zone describes
        <strong>winter lows</strong>, not frost dates. It is a useful default and most people
        know theirs, but it is a proxy. If you know your own average frost dates, the tool
        takes them directly &mdash; open &ldquo;use your own frost dates&rdquo; below the
        dropdowns.
      </p>
    </AnswerBox>

    <h2 id="what-to-plant">What to plant this month</h2>
    <CalendarTool />

    <h2 id="zone-pages">Full calendar for your zone</h2>
    <p>
      Each zone page has the complete month-by-month table, every crop's sowing and harvest
      window, and the frost dates behind them.
    </p>
    <div class="zone-grid">
      {
        zones.map((z) => (
          <a href={`/planting-calendar/zone-${z.zone}/`}>
            Zone {z.zone}
            <small>{z.seasonDays} frost-free days</small>
          </a>
        ))
      }
    </div>

    <h2 id="frost-dates">Frost dates and season length by zone</h2>
    <div class="table-wrap">
      <table>
        <caption>{zonesMeta.source}</caption>
        <thead>
          <tr>
            <th scope="col">Zone</th>
            <th scope="col">Winter low</th>
            <th scope="col">Avg last spring frost</th>
            <th scope="col">Avg first fall frost</th>
            <th scope="col">Frost-free days</th>
          </tr>
        </thead>
        <tbody>
          {
            zones.map((z) => (
              <tr>
                <th scope="row">
                  <a href={`/planting-calendar/zone-${z.zone}/`}>Zone {z.zone}</a>
                </th>
                <td>{z.minTempF}&deg;F</td>
                <td>{z.lastFrost}</td>
                <td>{z.firstFrost}</td>
                <td>{z.seasonDays}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <div class="note">
      <p>
        <strong>These are zone-wide averages.</strong> {zonesMeta.note}
      </p>
    </div>

    <h2 id="dataset">What is in the dataset</h2>
    <p>
      The calendar covers <strong>{crops.length} crops</strong> across
      <strong>{zones.length} zones</strong>. Each crop carries its sowing method and timing
      offset in weeks from the last frost, seed depth, plant and row spacing, minimum
      germination soil temperature, sun requirement and days to harvest. Fall sowing windows
      are calculated by backing off the first fall frost by the crop's slowest maturity plus a
      two-week buffer.
    </p>
    <p>{cropsMeta.note}</p>
    <p class="note">
      <strong>Known limitation.</strong> {cropsMeta.limitations}
    </p>
    <p>
      Succession sowings are generated for {crops.filter((c) => c.succession).length} of the
      crops on a {SUCCESSION_EVERY_DAYS}-day interval, running to the last sowing that can still
      mature before the first frost. Crops covered: {crops.map((c) => c.name).join(', ')}. The full depth and spacing table
      is on <a href="/">the main guide</a>, and the data is free to reuse with attribution
      (CC BY 4.0).
    </p>

    <h2 id="sources">Where the numbers come from</h2>
    <p>
      Crop timings, soil temperatures and spacings are cross-checked against cooperative
      extension publications. Frost dates by zone are the weakest link in any calendar like
      this one &mdash; they are conventional approximations rather than official figures,
      which is exactly why the tool lets you substitute your own.
    </p>
    <ul>
      {
        dataSources.map((src) => (
          <li>
            <a href={src.url} rel="noopener" target="_blank">
              {src.name}
            </a>{' '}
            &mdash; {src.used_for}.
          </li>
        ))
      }
    </ul>
    <p class="note">
      <strong>Nothing here replaces local advice.</strong> Your county cooperative extension
      office knows your frost dates, your soil and which varieties perform three streets away.
      Search &ldquo;cooperative extension&rdquo; plus your county name.
    </p>

    <Faq faqs={faqs} />
  </div>
</BaseLayout>
